<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - LukoChuri</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
        integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/stylesheets/root.css">
    <link rel="stylesheet" href="/stylesheets/landing.css">
</head>

<body>

    <div class="app">
        <main class="page landing-page">

            <nav>
                <div class="branding">
                    <div class="title-container">
                        <img src="/images/name_1.png" alt="appname">
                    </div>
                </div>
                <div class="play-now-btn">
                    <div class="play-now-btn-cont">
                        <span>Play Now</span>
                        <i class="fa-solid fa-person-running"></i>
                    </div>
                </div>
            </nav>

            <div class="seperator"></div>

            <div class="active-player-display">
                <div class="green-dot-cont">
                    <div class="dot"></div>
                    <div class="count"> <%= userCount %> </div>
                </div>
                <div class="rest">player(s) active</div>
            </div>

            <div class="hero">
                <span>Experience the fun of digital <span style="color: #FD0C19;">Luko</span>Churi where</span>
                <span class="rotating-text">
                    <span style="color: rgb(75, 226, 75)">Your City is The Map</span>
                    <span style="color: rgb(231, 171, 98);">Thrill is Amplified</span>
                    <span style="color: rgb(54, 189, 226);">Lekhbo Ela</span>
                    <span style="color: #FD0C19">Mathay Ashena Kichu</span>
                    <span style="color: rgb(75, 226, 75)">Your City is The Map</span>
                </span>
            </div>

            <div class="hero-image-outer-container">
                <div class="hero-image-container">
                    
                </div>
            </div>

        </main>
    </div>

</body>

</html>