<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - LukoChuri</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
        integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/stylesheets/root.css">
    <link rel="stylesheet" href="/stylesheets/join.css">
    <!-- sweetalert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css">
</head>

<body>

    <div class="app">
        <main class="page">

            <div class="container">
                <div class="branding">
                    <img src="/images/name_1.png" alt="brand">
                </div>
                <div class="discontinuous-seperator-cont">
                    <div></div>
                    <div></div>
                </div>
                <div class="input-container">
                    <p class="join-intro">Join The Fun</p>
                    <form action="/join" method="post" class="join-form">
                        <div class="email-input-cont">
                            <span><i class="fa-solid fa-at"></i></span>
                            <input type="email" name="email" id="email" placeholder="Enter An Email">
                        </div>
                        <div class="password-input-cont">
                            <span><i class="fa-solid fa-lock"></i></span>
                            <input type="password" name="password" id="passwd" placeholder="Enter A Password" min="6"
                                max="36">
                            <span id="pass_showhide_btn">
                                <i class="fa-regular fa-eye pass-showhide-btn"></i>
                            </span>
                        </div>
                        <div class="confirm-password-input-cont">
                            <span><i class="fa-solid fa-question"></i></span>
                            <input type="password" name="confirm_password" id="cnfpasswd"
                                placeholder="Confirm Your Password">
                            <span id="pass_showhide_btn_c">
                                <i class="fa-regular fa-eye pass-showhide-btn"></i>
                            </span>
                        </div>
                        <div class="sso-seperator">
                            <div class="seperator"></div>
                            <span>OR</span>
                            <div class="seperator"></div>
                        </div>
                        <div class="sso-cont">
                            <div class="google" id="google_sso_btn">
                                <svg viewBox="-3 0 262 262" xmlns="http://www.w3.org/2000/svg"
                                    preserveAspectRatio="xMidYMid" fill="#000000">
                                    <g id="SVGRepo_bgCarrier" stroke-width="0" />
                                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" />
                                    <g id="SVGRepo_iconCarrier">
                                        <path
                                            d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"
                                            fill="#4285F4" />
                                        <path
                                            d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"
                                            fill="#34A853" />
                                        <path
                                            d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782"
                                            fill="#FBBC05" />
                                        <path
                                            d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"
                                            fill="#EB4335" />
                                    </g>
                                </svg>
                            </div>
                            <div class="apple" id="apple_sso_btn"><i class="fa-brands fa-apple"></i></div>
                            <div class="facebook" id="facebook_sso_btn"><i class="fa-brands fa-facebook-f"></i></div>
                        </div>
                        <div class="extras-cont">
                            <div class="toc-cont">
                                <input type="checkbox" name="toc-status" id="toc_chkbox">
                                <span>Agree to <a href="/toc">Terms & Conditions</a></span>
                            </div>
                            <div class="ask-login-cont">
                                <span>Already Registered? <a href="/login">Sign In</a></span>
                            </div>
                        </div>

                        <div class="error-display"></div>

                        <div class="join-btn">
                            <div class="join-btn-cont">
                                <button type="submit">Join</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <script src="/scripts/joinPage.js"></script>
</body>

</html>